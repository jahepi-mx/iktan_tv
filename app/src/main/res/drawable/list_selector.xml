<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn ON TOP of the menu rows (drawSelectorOnTop), so the fill must be see-through
     or it hides the text. A thick Pokémon-blue frame + soft yellow tint marks the selection. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#66FFCB05" />
            <stroke android:width="6dp" android:color="#E3350D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFCB05" />
            <stroke android:width="6dp" android:color="#3B4CCA" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
