<?xml version="1.0" encoding="utf-8"?>
<!-- Grows and lifts the button when selected with the remote, shrinks back when unselected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.15" android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.15" android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="12dp" android:duration="150" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="150" android:valueType="floatType" />
        </set>
    </item>
</selector>
